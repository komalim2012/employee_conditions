<mvc:View controllerName="employee.controller.emp"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
    <Page id="page" >
    <Panel id="_IDGenPanel" expandable="true" headerText="{i18n>title}">
        <form:SimpleForm id="_IDGenSimpleForm" >
        <form:content>
            <Label id="lblIdname" text="{i18n>empName}" />
            <Input id="inptIdname" type="Text" />
            <Label id="lblIdid" text="{i18n>empId}"  required="true"/>
            <Input id="inptIdid" type="Number" /> 
            <Label id="lblIdeml" text="{i18n>empeml}" />
            <Input id="inptIdeml" type="Email" />
            <Label id="lblIddob" text="{i18n>empdob}" />
            <DateTimePicker id="dtpId" minutesStep="1" secondsStep="1" showCurrentTimeButton="true" showTimezone="true" timezone="Hyderabad,India"  />
            <Label id="lblIdslry" text="{i18n>empSalary}" />
            <Input id="inptIdslry"  />
            <Label id="lblIdgndr" text="{i18n>empGndr}" />
            <Select id="slctIdgndr" forceSelection="false">
                <items>
                   <core:Item id="itmIdM" key="M" text="{i18n>M}"/>
                   <core:Item id="itmIdF" key="F" text="{i18n>F}"/>
                   <core:Item id="itmIdT" key="T" text="{i18n>T}"/>
                </items>
            </Select>  
            <Label id="lblIddept" text="{i18n>slctDept}" /> 
            <ComboBox id="cmbIddept">
            <items>
                 <core:Item id="itmIdind" key="IT" text="{i18n>IT}"/>
                 <core:Item id="itmIdrus" key="SE" text="{i18n>SE}"/>
                 <core:Item id="itmIdaus" key="CS" text="{i18n>CS}"/>
            </items> 
            </ComboBox>     
            <Label id="lblIdcity" text="{i18n>slctCity}" />
            <Select id="slctIdcity" forceSelection="false">
                <items>
                   <core:Item id="itmIdh" key="H" text="{i18n>H}"/>
                   <core:Item id="itmIdo" key="O" text="{i18n>O}"/>
                   <core:Item id="itmIdc" key="C" text="{i18n>C}"/>
                </items>
            </Select>  
            <!-- <DatePicker id="_IDGenDatePicker" calendarWeekNumbering="ISO_8601" displayFormatType="" showFooter="false"/> -->
            <!-- <DateTimePicker id="dtpId" minutesStep="1" secondsStep="1" showCurrentTimeButton="true" showTimezone="true" timezone="Hyderabad,India"  />  -->
            <!-- <Button id="btnId" icon="sap-icon://accept" text="Submit" type="Success" press="onSubmit"/> -->
        </form:content>
        </form:SimpleForm>
        </Panel>
        <footer>
            <Bar id="_IDGenBar">
            <contentMiddle>
            <Button id="btnId" icon="sap-icon://accept" width="200px" text="{i18n>S}" type="Success" tooltip="press the button to submit" press="onSubmit"/>
            </contentMiddle>
            </Bar>
        </footer>
    </Page>
</mvc:View>